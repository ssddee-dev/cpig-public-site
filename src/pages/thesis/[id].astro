---
// 논지 상세 페이지 (정적 생성)
import { ledger } from '../../lib/data';
export function getStaticPaths() {
  return ledger.map(t => ({ params: { id: t.id_short }, props: { t } }));
}
const { t } = Astro.props;
const fals = t.falsification || {};
---
<!doctype html>
<html lang="ko"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{t.name_kr} — 오답노트 | Callchain</title>
<meta name="description" content={`${t.name_kr}: ${(t.public_summary||'').slice(0,140)}`}>
<link rel="canonical" href={`https://callchain.dev/thesis/${t.id_short}/`}>
<meta property="og:site_name" content="Callchain">
<meta property="og:type" content="article">
<meta property="og:title" content={`${t.name_kr} — 오답노트`}>
<meta property="og:description" content={`${(t.public_summary||'').slice(0,140)}`}>
<meta property="og:url" content={`https://callchain.dev/thesis/${t.id_short}/`}>
<meta property="og:image" content="https://callchain.dev/assets/callchain_banner.png">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={`${t.name_kr} — 오답노트`}>
<meta name="twitter:description" content={`${(t.public_summary||'').slice(0,140)}`}>
<meta name="twitter:image" content="https://callchain.dev/assets/callchain_banner.png">
<style>
:root{--bg:#0b0f14;--card:#0e1420;--line:#22304a;--tx:#dce3ec;--mut:#8b98a8;--blue:#7fb3ff;--grn:#4ade80;--red:#f87171;--yel:#f0b840}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--tx);font-family:-apple-system,BlinkMacSystemFont,'Noto Sans KR',system-ui,sans-serif;font-size:15px;line-height:1.7}
.wrap{max-width:760px;margin:0 auto;padding:0 16px 48px}h1{font-size:20px;color:var(--blue)}h2{font-size:15px;margin:22px 0 8px;color:var(--tx)}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px 18px;margin:12px 0}.meta{color:var(--mut);font-size:12.5px}
a{color:var(--blue);text-decoration:underline;text-underline-offset:2px}.ev{margin:10px 0;padding:12px;border:1px solid var(--line);border-radius:10px;background:#0d1219}
.lbl{display:inline-block;border:1px solid var(--line);border-radius:12px;padding:0 8px;font-size:12px;color:var(--mut);margin-right:8px}
.orig{color:var(--mut);font-size:12.5px;margin-top:6px}footer{margin-top:40px;padding-top:14px;border-top:1px solid var(--line);color:var(--mut);font-size:12.5px}
</style></head><body><main class="wrap">
<p class="meta"><a href={`${import.meta.env.BASE_URL}`}>← 원장 목록</a></p>
<h1>{t.name_kr}</h1>
<p class="meta">{t.direction} · {t.exposure_node} · 등록 {t.registered.date} · 다음 채점 {t.next_scoring}</p>
<p>{t.public_summary}</p>
<h2>이 논지가 틀렸다는 신호 (반증)</h2>
<div class="card"><p>{fals.core || ''}</p>{(fals.secondary||[]).map(s => <p class="meta">· {s}</p>)}</div>
{(t.confirmation||[]).length ? <><h2>논지가 맞다면 보이는 신호 (확인)</h2><div class="card">{(t.confirmation||[]).map(c => <p>· {c}</p>)}</div></> : ''}
<h2>형성 증거</h2>
{t.evidence.map(e => (
  <div class="ev"><span class="lbl">{e.label}</span><span class="meta">{e.quarter} · {e.target}</span><p>{e.fact}</p>{e.fact_original ? <p class="orig">원문: {e.fact_original}</p> : ''}</div>
))}
<h2>채점 규칙</h2>
<div class="card"><p>{t.scoring.rule}</p><p class="meta">데이터 기준일 {t.scoring.data_asof} · 관찰 종료 {t.scoring.observation_end}</p><p class="meta">{t.scoring.verdict_separate}</p></div>
<p class="meta">{t.registered.note}</p>
<footer>본 페이지는 시장 관찰 기록이며 투자 조언이 아닙니다.</footer>
</main></body></html>
