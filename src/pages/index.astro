---
// 시장 관찰 노트 — 논지 원장 (공개 발행본)
// 발행 승인: public_ledger.json (2026-08-06)
import { ledger } from '../lib/data';
const DIR_ICON = {'순풍(상방)':'▲','역풍(하방)':'▼','중립 관찰':'◆','구조적 관찰':'●'};
const cards = ledger.map(t => ({
  id: t.id_short, name: t.name_kr, dir: t.direction, node: t.exposure_node,
  summary: t.public_summary, date: t.registered.date, next: t.next_scoring,
  tickers: t.tickers_kr.join(', '), icon: DIR_ICON[t.direction]||'',
  status: t.status || '',
  cls: t.direction.includes('상방')?'up':t.direction.includes('하방')?'down':t.direction.includes('중립')?'mid':'stru'
}));
---
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>오답노트 — Callchain</title>
<meta name="description" content="추적 중인 시장 논지 9건의 공개 원장. 각 논지는 등록 시점에 공개 커밋으로 고정되며, 발행 이후 본문은 수정하지 않습니다. 반증 조건과 채점 결과를 투명하게 공개합니다.">
<link rel="canonical" href="https://callchain.dev/">
<meta property="og:site_name" content="Callchain">
<meta property="og:type" content="website">
<meta property="og:title" content="오답노트 — Callchain">
<meta property="og:description" content="사전 등록된 시장 논지, 반증 조건, 분기 채점을 공개하는 원장. 발행 이후 본문은 수정하지 않습니다.">
<meta property="og:url" content="https://callchain.dev/">
<meta property="og:image" content="https://callchain.dev/assets/callchain_banner.png">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="오답노트 — Callchain">
<meta name="twitter:description" content="사전 등록된 시장 논지, 반증 조건, 분기 채점을 공개하는 원장.">
<meta name="twitter:image" content="https://callchain.dev/assets/callchain_banner.png">
<style>
:root{--bg:#0b0f14;--card:#0e1420;--line:#22304a;--tx:#dce3ec;--mut:#8b98a8;--blue:#7fb3ff;--grn:#4ade80;--red:#f87171;--yel:#f0b840}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--tx);font-family:-apple-system,BlinkMacSystemFont,'Noto Sans KR',system-ui,sans-serif;font-size:15px;line-height:1.7}
.wrap{max-width:760px;margin:0 auto;padding:0 16px 48px}h1{font-size:22px;color:var(--blue)}h2{font-size:16px;color:var(--tx);margin:28px 0 10px}
.sub{color:var(--mut);font-size:13px}.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px 18px;margin:12px 0}
a{color:var(--blue);text-decoration:underline;text-underline-offset:2px}.dir{display:inline-block;padding:1px 10px;border-radius:14px;font-size:12px;margin-right:6px}
.up{background:#11301f;color:var(--grn);border:1px solid #1d4d2e}.down{background:#3a1414;color:var(--red);border:1px solid #5e2020}.mid{background:#33270b;color:var(--yel);border:1px solid #4d3b10}.stru{background:#10203a;color:var(--blue);border:1px solid #1d3557}
.meta{color:var(--mut);font-size:12.5px;margin-top:8px}.badge{display:inline-block;border:1px solid var(--line);border-radius:14px;padding:1px 9px;font-size:12px;color:var(--mut);margin-right:6px;margin-bottom:6px}
footer{margin-top:40px;padding-top:14px;border-top:1px solid var(--line);color:var(--mut);font-size:12.5px}
</style>
</head>
<body><main class="wrap">
<h1>오답노트</h1>
<p class="sub">추적 중인 시장 논지 9건의 원장입니다. 각 논지는 등록 시점에 공개 커밋으로 고정되며, 발행 이후 본문은 수정하지 않습니다.</p>

{cards.map(t => (
  <div class="card">
    <span class={`dir ${t.cls}`}>{t.icon} {t.dir}</span>
    <span class="badge">{t.node}</span>
    <h2 style="margin-top:8px"><a href={`${import.meta.env.BASE_URL}thesis/${t.id}/`}>{t.name}</a></h2>
    {t.status === '폐기' ? <span class="badge" style="color:var(--red);border-color:#5e2020">폐기 · 등록 품질 실패</span> : ''}
    <p>{t.summary}</p>
    <p class="meta">등록 {t.date} · 다음 채점 {t.next} · {t.tickers}</p>
  </div>
))}

<footer>
발행 전 수정 이력은 커밋으로 공개되어 있으며, 발행 시점 이후 논지 본문은 수정하지 않는다.<br>
본 페이지는 시장 관찰 기록이며 투자 조언이 아닙니다.
</footer>
</main></body></html>
